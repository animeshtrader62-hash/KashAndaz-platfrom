# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
.venv/
.pytest_cache/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/

# Python caches
__pycache__/

# Environment files
.env
**/.env

# Node
node_modules/
**/node_modules/

# Local tooling (not production code)
tools/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/build/
**/coverage/

# Backend secrets
backend/.env
backend/*.db

# Backend runtime artifacts (do not commit)
backend/uploads/
backend/uvicorn.out
backend/uvicorn.err

# Local git worktrees (do not commit)
backend-worktree/

# Sensitive keys
Documents/*.pem

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
public-app/android/app/debug
public-app/android/app/profile
public-app/android/app/release
