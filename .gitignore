# Local databases / audit artifacts
*.sqlite3
*.db

# Local backups
backups/

# Personal documents
Documents/

# Backend secrets
backend/.env

# Backend runtime artifacts (do not commit)
backend/uploads/
backend/uvicorn.out
backend/uvicorn.err

# Tests are not shipped in this repo
backend/tests/

# Sensitive keys
Documents/*.pem

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
